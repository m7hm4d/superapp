# الوكيل العكسي وطبقة TLS للبيئتين. ‏Caddy يصدر شهادات Let's Encrypt ويجددها
# وحده، ويعيد توجيه 80 إلى 443 تلقائياً.
#
# الوجهات أسماء مستعارة على شبكة superapp-edge تعلنها كل حزمة عن نفسها
# (‏prod-api و stage-api …) — لا أسماء خدمات، لأن الحزمتين تحملان الأسماء
# نفسها كلٌّ على شبكتها الداخلية.

{
	email {$ACME_EMAIL}
}

# ترويسات أمان مشتركة — HSTS يمنع الهبوط إلى HTTP بعد أول زيارة
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

(admin_site) {
	import security_headers
	# اللوحة لا تُؤطَّر في أي صفحة — يقطع هجمات النقر المخطوف
	header X-Frame-Options "DENY"
	encode zstd gzip
}

(api_site) {
	import security_headers
	encode zstd gzip
}

# ‏X-Forwarded-For بالاستبدال لا بالإلحاق: لو ألحقنا لأمكن العميل أن يزوّر
# أول عنوان في السلسلة، فيقرأ Express عنواناً يختاره المهاجم ويسقط حدّ
# محاولات الدخول. يقابله TRUST_PROXY=1 في الـAPI.
(upstream) {
	header_up X-Forwarded-For {remote_host}
}

# ————— الإنتاج —————

{$PROD_ADMIN_DOMAIN} {
	import admin_site
	reverse_proxy prod-admin:3001 {
		import upstream
	}
}

# ‏Caddy يمرّر ترقية WebSocket تلقائياً، فمسار Socket.io ‏(/rt) يعمل بلا إعداد
{$PROD_API_DOMAIN} {
	import api_site
	reverse_proxy prod-api:3000 {
		import upstream
	}
}

# ————— بيئة التجربة —————
#
# مفاتيح المرور مربوطة بالنطاق تشفيرياً، فمفتاح سُجّل هنا لا يعمل على
# الإنتاج والعكس. هذا مقصود: التجربة تُجرَّب بمفاتيح تُرمى.

{$STAGE_ADMIN_DOMAIN} {
	import admin_site
	reverse_proxy stage-admin:3001 {
		import upstream
	}
}

{$STAGE_API_DOMAIN} {
	import api_site
	reverse_proxy stage-api:3000 {
		import upstream
	}
}
