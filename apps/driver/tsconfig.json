{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@superapp/shared": [
        "../../packages/shared/src"
      ],
      "@superapp/shared/*": [
        "../../packages/shared/src/*"
      ],
      "@superapp/i18n": [
        "../../packages/i18n/src"
      ],
      "@superapp/i18n/*": [
        "../../packages/i18n/src/*"
      ],
      "@superapp/ui": [
        "../../packages/ui/src"
      ],
      "@superapp/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@superapp/api-client": [
        "../../packages/api-client/src"
      ],
      "@superapp/api-client/*": [
        "../../packages/api-client/src/*"
      ],
      "@superapp/map": [
        "../../packages/map/src"
      ],
      "@superapp/map/*": [
        "../../packages/map/src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react-native": [
        "./node_modules/react-native"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ]
    }
  },
  "include": [
    "app",
    "src",
    "nativewind-env.d.ts"
  ]
}
