{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "strictPropertyInitialization": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@superapp/shared": [
        "../../packages/shared/src/index.ts"
      ],
      "@superapp/shared/*": [
        "../../packages/shared/src/*"
      ]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "test",
    "../../packages/shared/src",
    "scripts"
  ]
}
