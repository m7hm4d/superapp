{
  "$schema": "https://json-schema.org/schema",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "apps/api/src/main",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "db/migrations/**/*",
        "outDir": "dist/apps/api/src"
      }
    ]
  }
}
