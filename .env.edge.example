# حافة TLS المشتركة — انسخه إلى .env.edge على الخادم.
#   cp .env.edge.example .env.edge
#
# ‏Caddy واحد يخدم البيئتين: 80 و443 لا يربطهما أكثر من عملية، وACME
# يحتاجهما فعلاً.

# بريد إشعارات انتهاء الشهادات من Let's Encrypt
ACME_EMAIL=you@example.com

# --- الإنتاج ---
PROD_ADMIN_DOMAIN=admin.4irq.com
PROD_API_DOMAIN=api.4irq.com

# --- التجربة ---
# اتركهما على الافتراضي ‎.localhost إن لم تشغّل بيئة تجربة: عندها يصدر
# Caddy شهادة داخلية ولا يقصد Let's Encrypt لنطاق لا وجود له في DNS.
STAGE_ADMIN_DOMAIN=stage.4irq.com
STAGE_API_DOMAIN=api-stage.4irq.com
