# --- Database ---
DATABASE_URL=postgres://superapp:superapp@localhost:5432/superapp

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
