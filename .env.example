# --- Database ---
DATABASE_URL=postgres://superapp:superapp@localhost:5432/superapp

# --- Auth ---
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh
JWT_REFRESH_TTL=30d
# كلمة مرور أدمن الـ seed — يقرأها db:seed فقط؛ إن غابت تُولَّد عشوائياً وتُطبع مرة واحدة.
# إعادة تشغيل الـ seed بقيمة جديدة تُدوِّر كلمة مرور الأدمن القائمة.
SEED_ADMIN_PASSWORD=
# سر TOTP جاهز للأدمن — للتطوير والاختبارات الآلية فقط (base32).
# اتركه فارغاً في أي بيئة حقيقية: TOTP إلزامي ويسجّله الأدمن بمسح QR عند أول دخول.
SEED_ADMIN_TOTP_SECRET=

# --- مفاتيح المرور (WebAuthn) ---
# المفتاح مربوط بالنطاق تشفيرياً ولا يقبل عنوان IP إطلاقاً.
# RP_ID نطاق مجرّد، وORIGINS أصل كامل بمنفذه (يفصل بينها فاصلة).
# مثال إنتاج: WEBAUTHN_RP_ID=ops.4irq.com و WEBAUTHN_ORIGINS=https://ops.4irq.com
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SuperApp Admin
WEBAUTHN_ORIGINS=http://localhost:3001

# --- API ---
PORT=3000
CORS_ORIGINS=http://localhost:3001

# --- Ops defaults (overridable per city row) ---
DEFAULT_DELIVERY_FEE_IQD=2000
VENDOR_ACCEPT_TIMEOUT_MIN=10
BATCH_WINDOW_SEC=75
BATCH_OFFER_TTL_SEC=60

# --- Optional ---
SENTRY_DSN=
