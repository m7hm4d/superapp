{
  "name": "superapp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @superapp/api dev",
    "dev:admin": "pnpm --filter @superapp/admin dev",
    "dev:customer": "pnpm --filter @superapp/customer start",
    "dev:vendor": "pnpm --filter @superapp/vendor start",
    "dev:driver": "pnpm --filter @superapp/driver start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @superapp/api db:migrate",
    "db:seed": "pnpm --filter @superapp/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.66.0"
  }
}
