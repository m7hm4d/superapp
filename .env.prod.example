# انسخه إلى .env.prod على الخادم وعبّئه. لا يُرفع إلى git إطلاقاً.
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# توليد الأسرار:  openssl rand -base64 36

# --- النطاقات ---
# ‏WebAuthn يربط مفتاح المرور بالنطاق تشفيرياً: أي تغيير هنا يبطل كل
# المفاتيح المسجّلة. اختر النطاق النهائي قبل أن يسجّل أحد مفتاحه.
ADMIN_DOMAIN=admin.4irq.com
API_DOMAIN=api.4irq.com
# بريد إشعارات انتهاء الشهادات من Let's Encrypt
ACME_EMAIL=you@example.com

# --- قاعدة البيانات ---
# اسم المضيف db هو اسم الخدمة في الشبكة الداخلية لا localhost.
# ‏POSTGRES_PASSWORD و DATABASE_URL يجب أن تتطابقا.
POSTGRES_USER=superapp
POSTGRES_PASSWORD=
POSTGRES_DB=superapp
DATABASE_URL=postgres://superapp:PASSWORD_HERE@db:5432/superapp

# --- الـAPI ---
NODE_ENV=production
PORT=3000
# عدد الوكلاء العكسيين أمام الـAPI. ‏Caddy وحده = 1.
# صفر خلف وكيل يعني أن حدّ محاولات الدخول يرى كل الزوار عنواناً واحداً.
TRUST_PROXY=1
CORS_ORIGINS=https://admin.4irq.com

# --- التوكنات ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL=30d

# --- مفاتيح المرور (WebAuthn) ---
# ‏RP_ID نطاق مجرّد بلا بروتوكول، وORIGINS أصل كامل. لا يقبل عنوان IP.
WEBAUTHN_RP_ID=admin.4irq.com
WEBAUTHN_RP_NAME=SuperApp Admin
WEBAUTHN_ORIGINS=https://admin.4irq.com

# --- حدّ محاولات المصادقة (لكل IP) ---
AUTH_THROTTLE_LIMIT=5
AUTH_THROTTLE_TTL_MS=60000

# --- الـseed (مرة واحدة عند أول نشر) ---
# كلمة مرور أدمن اللوحة. أفرغه بعد أول تشغيل ناجح للـseed.
# إعادة تشغيل الـseed بقيمة جديدة تُدوِّر كلمة المرور القائمة.
SEED_ADMIN_PASSWORD=
# اتركه فارغاً دائماً في الإنتاج — TOTP يُسجَّل بمسح QR عند أول دخول.
SEED_ADMIN_TOTP_SECRET=

# --- لوحة الإدارة (وقت البناء) ---
# الأصل فقط بلا مسار: عميل الـAPI يضيف /api/v1 وحده.
# يُخبَز في حزمة المتصفح: تغييره يستلزم إعادة بناء صورة اللوحة.
NEXT_PUBLIC_API_URL=https://api.4irq.com

# --- الافتراضيات التشغيلية ---
DEFAULT_DELIVERY_FEE_IQD=2000
VENDOR_ACCEPT_TIMEOUT_MIN=10
BATCH_WINDOW_SEC=75
BATCH_OFFER_TTL_SEC=60

# --- اختياري ---
SENTRY_DSN=
